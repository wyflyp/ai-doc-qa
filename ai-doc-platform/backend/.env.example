# ===== 大模型配置 =====
LLM_API_KEY=sk-在这里填你的APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 送进大模型的文档字符上限。上下文有成本，也怕超出模型窗口
DOC_CHAR_BUDGET=12000

# ===== MySQL 配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=ai_doc_platform

# ===== 检索配置 =====
# 混合检索的 RRF 权重。换语料后建议用 eval_suite.py --tune 重新标定
RRF_WEIGHT_VECTOR=1.0
RRF_WEIGHT_BM25=1.0

# 精排开关与参数
RERANK_ENABLED=true
RERANK_CANDIDATES=20
RERANK_MAX_CHARS=400

# 子问题分解（跨文档题）
QUERY_DECOMPOSE_ENABLED=true

# 查询改写（默认关闭：实测叠加精排后无增益）
QUERY_REWRITE_ENABLED=false
